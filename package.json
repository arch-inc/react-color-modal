{
  "name": "react-color-modal",
  "version": "0.0.17",
  "description": "Yet another color picker component for React",
  "main": "dist/index.js",
  "browser": "dist/index.js",
  "module": "dist/index.es.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "vitest run",
    "build": "npm run build:lib && npm run next",
    "build:docs": "npm run next && npm run typedoc",
    "build:lib": "npm run build:js && npm run build:types",
    "build:js": "cross-env NODE_ENV=production rollup -c",
    "build:types": "tsc --emitDeclarationOnly",
    "clean": "npm run clean:docs && npm run clean:lib",
    "clean:docs": "del-cli docs/out",
    "clean:lib": "del-cli dist",
    "dev": "npm run next:dev",
    "next": "npm run next:build",
    "next:build": "next build ./docs",
    "next:dev": "next ./docs",
    "next:start": "next start ./docs",
    "prettify": "prettier --write ./**/*.{ts,tsx}",
    "typedoc": "typedoc --excludeInternal --excludeExternals --excludePrivate --excludeProtected --out ./docs/out/api ./lib/index.ts",
    "watch": "rollup -cw"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arch-inc/react-color-modal.git"
  },
  "keywords": [
    "react",
    "color-picker",
    "color picker",
    "color",
    "picker"
  ],
  "author": "Jun Kato <i@junkato.jp> (https://junkato.jp)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/arch-inc/react-color-modal/issues"
  },
  "homepage": "https://github.com/arch-inc/react-color-modal#readme",
  "dependencies": {
    "tinycolor2": "^1.6.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/tinycolor2": "^1.4.6",
    "babel-plugin-styled-components": "^2.3.0",
    "cross-env": "^10.1.0",
    "del-cli": "^7.0.0",
    "jsdom": "^30.0.1",
    "next": "^16.3.2",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rollup": "^4.62.5",
    "styled-components": "^6.5.3",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "styled-components": ">=5"
  }
}
